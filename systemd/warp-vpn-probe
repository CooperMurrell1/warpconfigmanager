#!/bin/sh
set -eu
CONTROL=/opt/warp-manager/control/warp-config-manager
REQUEST="$CONTROL/manager-request.json"
RESULT="$CONTROL/manager-result.json"

log() {
  printf '%s [warp-vpn-manager] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"
}

if [ ! -f "$REQUEST" ] || [ -L "$REQUEST" ]; then exit 1; fi
ID=$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([a-f0-9]\{32\}\)".*/\1/p' "$REQUEST" | head -n 1)
ACTION=$(sed -n 's/.*"action"[[:space:]]*:[[:space:]]*"\([a-z-]*\)".*/\1/p' "$REQUEST" | head -n 1)
EXPECTED_KEY=$(sed -n 's/.*"expected_public_key"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9+/=]*\)".*/\1/p' "$REQUEST" | head -n 1)
case "$ID" in ''|*[!a-f0-9]*) exit 1 ;; esac
case "$ACTION" in probe-tunnel-ip|activate-config) ;; *) exit 1 ;; esac
case "$EXPECTED_KEY" in *[!A-Za-z0-9+/=]*) exit 1 ;; esac
[ "$ACTION" != activate-config ] || [ -n "$EXPECTED_KEY" ] || exit 1
log "request accepted id=$ID action=$ACTION"

ok=true
message=ok
ip=""
config_loaded=null
restarted_count=0
dependent_count=0
dependent_failed_count=0
dependent_ids=""
dependent_names=""
dependent_services=""
if [ -n "$EXPECTED_KEY" ]; then config_loaded=false; fi

probe_ip() {
  log "checking public IP from inside qbittorrentvpn"
  if docker exec qbittorrentvpn sh -c 'command -v curl >/dev/null 2>&1'; then
    probe_tool=curl
  elif docker exec qbittorrentvpn sh -c 'command -v wget >/dev/null 2>&1'; then
    probe_tool=wget
  else
    message=vpn-probe-tool-missing
    return 1
  fi

  attempt=0
  saw_invalid=false
  while [ "$attempt" -lt 5 ]; do
    probe_status=0
    value=""
    if [ "$probe_tool" = curl ]; then
      value=$(docker exec qbittorrentvpn curl -4 --fail --silent --show-error --max-time 15 https://api.ipify.org 2>/dev/null) || probe_status=$?
    else
      value=$(docker exec qbittorrentvpn wget -4 -qO- -T 15 https://api.ipify.org 2>/dev/null) || probe_status=$?
    fi
    if [ "$probe_status" -eq 0 ]; then
      case "$value" in
        ''|*[!0-9.]*) saw_invalid=true ;;
        *) ip="$value"; log "public IP probe succeeded"; return 0 ;;
      esac
    fi
    log "public IP probe attempt $((attempt + 1)) failed (exit=$probe_status)"
    attempt=$((attempt + 1))
    [ "$attempt" -ge 5 ] || sleep 2
  done

  if [ "$saw_invalid" = true ]; then
    message=tunnel-ip-probe-invalid-response
  else
    message=tunnel-ip-probe-command-failed
  fi
  return 1
}

key_is_loaded() {
  interfaces=$(docker exec qbittorrentvpn wg show interfaces 2>/dev/null || true)
  for interface in $interfaces; do
    public_key=$(docker exec qbittorrentvpn wg show "$interface" public-key 2>/dev/null || true)
    if [ "$public_key" = "$EXPECTED_KEY" ]; then
      log "expected WireGuard key is loaded on interface $interface"
      return 0
    fi
  done
  return 1
}

compose_declares_vpn_network() {
  cdc_container="$1"
  cdc_service=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.service"}}' "$cdc_container" 2>/dev/null || true)
  cdc_project_dir=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$cdc_container" 2>/dev/null || true)
  cdc_files=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project.config_files"}}' "$cdc_container" 2>/dev/null || true)
  case "$cdc_service:$cdc_project_dir:$cdc_files" in *'<no value>'*|::*|*::)
    [ -n "$cdc_service" ] && log "Compose config lookup unavailable for container=$cdc_container: project labels are incomplete"
    return 1
    ;;
  esac
  [ -n "$cdc_service" ] && [ -n "$cdc_project_dir" ] && [ -n "$cdc_files" ] || return 1
  log "Compose source labels: project=$compose_project service=$cdc_service working_dir=$cdc_project_dir config_files=$cdc_files"

  cdc_host_project_dir=$(portainer_path_to_host "$cdc_project_dir")
  if [ -n "$cdc_host_project_dir" ] && [ -d "$cdc_host_project_dir" ]; then
    log "mapped Portainer project directory $cdc_project_dir to host path $cdc_host_project_dir"
    cdc_project_dir=$cdc_host_project_dir
  fi

  set --
  cdc_remaining="$cdc_files"
  cdc_host_files=""
  while :; do
    case "$cdc_remaining" in
      *,*) cdc_file=${cdc_remaining%%,*}; cdc_remaining=${cdc_remaining#*,} ;;
      *) cdc_file=$cdc_remaining; cdc_remaining="" ;;
    esac
    [ -n "$cdc_file" ] || return 1
    case "$cdc_file" in /*) ;; *) cdc_file="$cdc_project_dir/$cdc_file" ;; esac
    cdc_host_file=$(portainer_path_to_host "$cdc_file")
    if [ -n "$cdc_host_file" ] && [ -f "$cdc_host_file" ]; then
      log "mapped Portainer Compose file $cdc_file to host path $cdc_host_file"
      cdc_file=$cdc_host_file
    fi
    [ -f "$cdc_file" ] || {
      log "Compose config file is not readable on the host for container=$cdc_container: $cdc_file"
      return 1
    }
    if [ -n "$cdc_host_files" ]; then cdc_host_files="$cdc_host_files,$cdc_file"; else cdc_host_files="$cdc_file"; fi
    set -- "$@" -f "$cdc_file"
    [ -n "$cdc_remaining" ] || break
  done
  cdc_files="$cdc_host_files"

  cdc_match=""
  if docker compose version >/dev/null 2>&1; then
    cdc_match=$(docker compose --project-directory "$cdc_project_dir" "$@" config --format json 2>/dev/null |
      python3 -c 'import json,sys; d=json.load(sys.stdin); s=d.get("services",{}).get(sys.argv[1],{}); print("match" if s.get("network_mode") == "service:qbittorrentvpn" else "no-match")' "$cdc_service" 2>/dev/null || true)
  elif command -v docker-compose >/dev/null 2>&1; then
    cdc_match=$(docker-compose --project-directory "$cdc_project_dir" "$@" config --format json 2>/dev/null |
      python3 -c 'import json,sys; d=json.load(sys.stdin); s=d.get("services",{}).get(sys.argv[1],{}); print("match" if s.get("network_mode") == "service:qbittorrentvpn" else "no-match")' "$cdc_service" 2>/dev/null || true)
  else
    log "Compose config lookup unavailable for container=$cdc_container: Docker Compose command not found"
    return 1
  fi
  if [ "$cdc_match" = match ]; then return 0; fi
  log "Compose config did not confirm network_mode=service:qbittorrentvpn for project=$compose_project service=$cdc_service (render result=${cdc_match:-unavailable})"
  return 1
}

portainer_path_to_host() {
  printf '%s\n' "$(docker inspect --format '{{range .Mounts}}{{printf "%s\t%s\n" .Destination .Source}}{{end}}' portainer 2>/dev/null || true)" |
    awk -F '\t' -v path="$1" '
      {
        dest=$1; source=$2
        if (path == dest || substr(path, 1, length(dest) + 1) == dest "/") {
          if (length(dest) > best) {
            best=length(dest)
            suffix=substr(path, length(dest) + 1)
            result=source suffix
          }
        }
      }
      END { if (result != "") print result }
    '
}

compose_force_recreate_service() {
  cfr_service="$cdc_service"
  cfr_project_dir="$cdc_project_dir"
  cfr_files="$cdc_files"
  set --
  cfr_remaining="$cfr_files"
  while :; do
    case "$cfr_remaining" in
      *,*) cfr_file=${cfr_remaining%%,*}; cfr_remaining=${cfr_remaining#*,} ;;
      *) cfr_file=$cfr_remaining; cfr_remaining="" ;;
    esac
    [ -n "$cfr_file" ] || return 1
    set -- "$@" -f "$cfr_file"
    [ -n "$cfr_remaining" ] || break
  done
  log "recreating Compose service $compose_project/$cfr_service from its source config"
  if docker compose version >/dev/null 2>&1; then
    if docker compose --project-directory "$cfr_project_dir" "$@" up --detach --no-deps --force-recreate --no-build "$cfr_service"; then
      :
    else
      cfr_status=$?
      log "docker compose up failed for $compose_project/$cfr_service with exit code $cfr_status"
      return 1
    fi
  elif command -v docker-compose >/dev/null 2>&1; then
    if docker-compose --project-directory "$cfr_project_dir" "$@" up --detach --no-deps --force-recreate --no-build "$cfr_service"; then
      :
    else
      cfr_status=$?
      log "docker-compose up failed for $compose_project/$cfr_service with exit code $cfr_status"
      return 1
    fi
  else
    return 1
  fi

  cfr_ids=$(docker ps --all --quiet --no-trunc \
    --filter "label=com.docker.compose.project=$compose_project" \
    --filter "label=com.docker.compose.service=$cfr_service")
  [ -n "$cfr_ids" ] || {
    log "Compose reported success but no containers exist for $compose_project/$cfr_service"
    return 1
  }
  cfr_failed=false
  for cfr_id in $cfr_ids; do
    cfr_running=$(docker inspect --format '{{.State.Running}}' "$cfr_id" 2>/dev/null || true)
    cfr_mode=$(docker inspect --format '{{.HostConfig.NetworkMode}}' "$cfr_id" 2>/dev/null || true)
    cfr_namespace_id=""
    case "$cfr_mode" in container:*) cfr_namespace_id=$(docker inspect --format '{{.Id}}' "${cfr_mode#container:}" 2>/dev/null || true) ;; esac
    log "post-recreate check service=$compose_project/$cfr_service id=$cfr_id running=$cfr_running network_mode=${cfr_mode:-unavailable} namespace_id=${cfr_namespace_id:-unresolved} expected_vpn_id=$vpn_id"
    if [ "$cfr_running" != true ] || [ "$cfr_namespace_id" != "$vpn_id" ]; then cfr_failed=true; fi
  done
  [ "$cfr_failed" = false ]
}

running=$(docker inspect --format '{{.State.Running}}' qbittorrentvpn 2>/dev/null || true)
if [ "$running" != true ]; then
  ok=false
  message=vpn-container-not-running
elif [ "$ACTION" = activate-config ]; then
  vpn_id=$(docker inspect --format '{{.Id}}' qbittorrentvpn 2>/dev/null || true)
  vpn_pid=$(docker inspect --format '{{.State.Pid}}' qbittorrentvpn 2>/dev/null || true)
  vpn_netns=""
  case "$vpn_pid" in ''|0|*[!0-9]*) ;; *) vpn_netns=$(readlink "/proc/$vpn_pid/ns/net" 2>/dev/null || true) ;; esac
  if [ -z "$vpn_id" ]; then
    ok=false
    message=vpn-container-metadata-unavailable
  else
    log "qBittorrentVPN container id=$vpn_id; scanning all containers for a shared network namespace"
    dependents=""
    for container in $(docker ps --all --quiet --no-trunc); do
      [ "$container" != "$vpn_id" ] || continue
      network_mode=$(docker inspect --format '{{.HostConfig.NetworkMode}}' "$container" 2>/dev/null || true)
      container_name=$(docker inspect --format '{{.Name}}' "$container" 2>/dev/null || true)
      container_pid=$(docker inspect --format '{{.State.Pid}}' "$container" 2>/dev/null || true)
      compose_service=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.service"}}' "$container" 2>/dev/null || true)
      compose_project=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$container" 2>/dev/null || true)
      container_netns=""
      case "$container_pid" in ''|0|*[!0-9]*) ;; *) container_netns=$(readlink "/proc/$container_pid/ns/net" 2>/dev/null || true) ;; esac
      log "examining container name=${container_name#/} id=$container compose_project=${compose_project:-unavailable} compose_service=${compose_service:-unavailable} network_mode=${network_mode:-unavailable} pid=${container_pid:-unavailable} netns=${container_netns:-unavailable}"
      matched=false
      if compose_declares_vpn_network "$container"; then
        matched=true
        log "container name=${container_name#/} id=$container matched from Compose config: service=${compose_service} network_mode=service:qbittorrentvpn project=${compose_project}"
      fi
      case "$network_mode" in
        container:*)
          namespace_ref=${network_mode#container:}
          namespace_id=$(docker inspect --format '{{.Id}}' "$namespace_ref" 2>/dev/null || true)
          log "container=${container_name#/} id=$container network_mode=$network_mode namespace_id=${namespace_id:-unresolved}"
          if [ "$namespace_id" = "$vpn_id" ] || [ "$namespace_ref" = "$vpn_id" ] || [ "$namespace_ref" = "qbittorrentvpn" ] || [ "$namespace_ref" = "/qbittorrentvpn" ]; then
            matched=true
            log "container name=${container_name#/} id=$container matched from Docker's resolved network mode $network_mode"
          fi
          ;;
        *) log "container name=${container_name#/} id=$container does not share a container network namespace" ;;
      esac
      if [ -n "$vpn_netns" ] && [ "$container_netns" = "$vpn_netns" ]; then
        matched=true
        log "container name=${container_name#/} id=$container matched by shared Linux network namespace $vpn_netns"
      fi
      if [ "$matched" = true ]; then
        dependents="$dependents $container"
        dependent_count=$((dependent_count + 1))
        if [ -n "$dependent_ids" ]; then dependent_ids="$dependent_ids,$container"; else dependent_ids="$container"; fi
        dependent_name=${container_name#/}
        if [ -n "$dependent_names" ]; then dependent_names="$dependent_names,$dependent_name"; else dependent_names="$dependent_name"; fi
        dependent_service="${compose_project:-unknown}/${compose_service:-unknown}"
        if [ -n "$dependent_services" ]; then dependent_services="$dependent_services,$dependent_service"; else dependent_services="$dependent_service"; fi
        log "matched routed dependent name=${container_name#/} id=$container running=$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)"
      else
        log "container name=${container_name#/} id=$container was not matched to qBittorrentVPN"
      fi
    done
    log "namespace discovery complete; matched=$dependent_count ids=${dependent_ids:-none}"

    log "restarting qBittorrentVPN"
    if ! docker restart --time 30 qbittorrentvpn >/dev/null 2>&1; then
      ok=false
      message=vpn-container-restart-failed
      log "qBittorrentVPN restart failed"
    else
      restarted_count=1
      vpn_running=$(docker inspect --format '{{.State.Running}}' qbittorrentvpn 2>/dev/null || true)
      log "qBittorrentVPN restart command completed; running=$vpn_running"
      if [ "$vpn_running" != true ]; then
        ok=false
        message=vpn-container-not-ready
      else
        if [ "$dependent_count" -eq 0 ]; then
          message=no-routed-containers-found
          log "warning: no dependent containers matched; continuing config activation and WireGuard key verification"
        fi
        processed_services=""
        processed_containers=""
        restart_failed=false
        for container in $dependents; do
          case " $processed_containers " in
            *" $container "*) log "container id=$container was already handled as part of a Compose service recreation"; continue ;;
          esac
          if compose_declares_vpn_network "$container"; then
            service_key="$compose_project/$cdc_service"
            case " $processed_services " in
              *" $service_key "*) log "Compose service $service_key was already recreated; skipping duplicate container entry" ;;
              *)
                processed_services="$processed_services $service_key"
                service_container_count=0
                for related in $dependents; do
                  related_project=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$related" 2>/dev/null || true)
                  related_service=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.service"}}' "$related" 2>/dev/null || true)
                  if [ "$related_project/$related_service" = "$service_key" ]; then
                    service_container_count=$((service_container_count + 1))
                    processed_containers="$processed_containers $related"
                  fi
                done
                [ "$service_container_count" -gt 0 ] || service_container_count=1
                if compose_force_recreate_service; then
                  restarted_count=$((restarted_count + service_container_count))
                  log "Compose service $service_key recreated successfully; containers=$service_container_count"
                else
                  restart_failed=true
                  dependent_failed_count=$((dependent_failed_count + service_container_count))
                  log "Compose service $service_key failed to recreate from its source config"
                fi
                ;;
            esac
          else
            dependent_running=$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)
            if [ "$dependent_running" = true ]; then
              log "restarting routed dependent without readable Compose config id=$container"
              if docker restart --time 15 "$container" >/dev/null 2>&1; then
                restarted_count=$((restarted_count + 1))
                log "restart succeeded for routed dependent id=$container"
              else
                restart_failed=true
                dependent_failed_count=$((dependent_failed_count + 1))
                log "restart failed for routed dependent id=$container"
              fi
            else
              log "starting stopped routed dependent without readable Compose config id=$container"
              if docker start "$container" >/dev/null 2>&1; then
                restarted_count=$((restarted_count + 1))
                log "start succeeded for routed dependent id=$container"
              else
                restart_failed=true
                dependent_failed_count=$((dependent_failed_count + 1))
                log "start failed for routed dependent id=$container"
              fi
            fi
          fi
        done
        if [ "$restart_failed" = true ]; then
          message=dependent-container-restart-failed
          log "warning: one or more dependent restarts failed; continuing WireGuard key verification"
        fi
        log "dependent restart batch complete; matched=$dependent_count restarted_total=$restarted_count failed_count=$dependent_failed_count"
      fi
    fi
  fi

  if [ "$ok" = true ]; then
    log "waiting up to 90 seconds for the expected WireGuard key"
    loaded=false
    attempt=0
    while [ "$attempt" -lt 90 ]; do
      if key_is_loaded; then loaded=true; break; fi
      attempt=$((attempt + 1))
      if [ $((attempt % 10)) -eq 0 ]; then log "WireGuard key verification still waiting; elapsed=${attempt}s"; fi
      sleep 1
    done
    if [ "$loaded" = true ]; then
      config_loaded=true
      if [ "$dependent_count" -gt 0 ] && [ "$dependent_failed_count" -eq 0 ]; then message=config-activated; fi
      log "config activation verified"
      probe_ip || true
    else
      ok=false
      message=generated-config-not-active
      log "config activation verification failed"
    fi
  fi
else
  if ! probe_ip; then ok=false; fi
  if [ "$ok" = true ] && [ -n "$EXPECTED_KEY" ]; then
    if key_is_loaded; then
      config_loaded=true
    else
      config_loaded=false
      message=generated-config-not-active
    fi
  fi
fi

umask 077
tmp=$(mktemp "$CONTROL/.result.XXXXXX")
printf '{"id":"%s","ok":%s,"message":"%s","ip":"%s","config_loaded":%s,"restarted_count":%s,"dependent_count":%s,"dependent_failed_count":%s,"dependent_ids":"%s","dependent_names":"%s","dependent_services":"%s","finished_at":"%s"}\n' \
  "$ID" "$ok" "$message" "$ip" "$config_loaded" "$restarted_count" "$dependent_count" "$dependent_failed_count" "$dependent_ids" "$dependent_names" "$dependent_services" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp"
log "request complete id=$ID ok=$ok message=$message vpn_restarted=$restarted_count dependents_matched=$dependent_count dependents_failed=$dependent_failed_count dependent_ids=${dependent_ids:-none} dependent_names=${dependent_names:-none} dependent_services=${dependent_services:-none}"
chmod 0600 "$tmp"
mv -f "$tmp" "$RESULT"
