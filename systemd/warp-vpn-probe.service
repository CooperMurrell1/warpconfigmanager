[Unit]
Description=Manage the qBittorrentVPN WARP config and probe its active tunnel

[Service]
Type=oneshot
TimeoutStartSec=600
User=root
Group=root
ExecStart=/usr/local/sbin/warp-vpn-manager
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/warp-manager/control/warp-config-manager
